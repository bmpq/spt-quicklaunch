<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(Configuration)' == 'SPT_4_1'">netstandard2.1</TargetFramework>
    <TargetFramework Condition="'$(Configuration)' == 'SPT_5_0'">net10.0</TargetFramework>
    <AssemblyName>tarkin.raidloadingtweaks</AssemblyName>
    <Version>1.3.0</Version>
    <LangVersion>latest</LangVersion>
    <RootNamespace>tarkin.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Configurations>SPT_4_1;SPT_5_0</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'SPT_4_1'">
    <Reference Include="$(SPT41Path)\BepInEx\core\BepInEx.dll" />
    <Reference Include="$(SPT41Path)\BepInEx\core\0Harmony.dll" />
    <Reference Include="$(SPT41Path)\BepInEx\plugins\spt\spt-reflection.dll" />

    <Reference Include="$(SPT41Path)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll" />
    <Reference Include="$(SPT41Path)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll" />
    <Reference Include="$(SPT41Path)\EscapeFromTarkov_Data\Managed\Comfort.Unity.dll" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(Configuration)' == 'SPT_5_0'">
    <Reference Include="$(SPT50Path)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\core\BepInEx.Unity.Common.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\core\BepInEx.Core.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\core\Il2CppInterop.Common.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\core\Il2CppInterop.Runtime.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\core\Il2CppInterop.HarmonySupport.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\core\0Harmony.dll" />

    <Reference Include="$(SPT50Path)\BepInEx\plugins\sptushonka\SPTushonka.Core.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\plugins\sptushonka\SPTushonka.Common.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\plugins\sptushonka\SPTushonka.SinglePlayer.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\plugins\sptushonka\SPTushonka.Reflection.dll" />

    <Reference Include="$(SPT50Path)\BepInEx\interop\Il2Cppmscorlib.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\interop\Il2CppSystem.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\interop\Il2CppSystem.Core.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\interop\CoreServices.dll" />

    <Reference Include="$(SPT50Path)\BepInEx\interop\Assembly-CSharp.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\interop\Comfort.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\interop\Comfort.Unity.dll" />
    <Reference Include="$(SPT50Path)\BepInEx\interop\Sirenix.Serialization.dll" />
  </ItemGroup>

  <Target Name="CopyDllAfterBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'SPT_4_1'">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(SPT41Path)\BepInEx\plugins" />
  </Target>
  <Target Name="CopyDllAfterBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'SPT_5_0'">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(SPT50Path)\BepInEx\plugins" />
  </Target>
</Project>
